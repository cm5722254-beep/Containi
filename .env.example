# ==========================================
# ENVIRONMENT CONFIGURATION (.env.example)
# CTN University Project: Containerized E-Commerce
# ==========================================

# Database Configuration (PostgreSQL Container)
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_university_password_2026
POSTGRES_PORT=5432

# Database URL used by Backend container (Note: hostname is 'postgres', NOT 'localhost')
DATABASE_URL=postgresql://admin:secure_university_password_2026@postgres:5432/ecommerce

# Redis Configuration (Redis Container: hostname is 'redis', NOT 'localhost')
REDIS_URL=redis://redis:6379

# Backend API Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_ctn_containers_2026
CORS_ORIGIN=*

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api
